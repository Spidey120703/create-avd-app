{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "create-avd-app",
  "version": "0.1.0",
  "identifier": "io.spidey.create-avd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Virtual Device Configuration",
        "width": 1250,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
